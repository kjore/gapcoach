# Copy to .env (or run scripts/setup.sh, which fills __PROJECT_ROOT__ for you).
# Every value here is a local placeholder: no real key, token or password belongs in this file.

# --- PowerContext server (memory) ---
POWERCONTEXT_HOME=__PROJECT_ROOT__/data/powercontext
POWERCONTEXT_SERVER_HTTP_HOST=127.0.0.1
POWERCONTEXT_SERVER_HTTP_PORT=18080
POWERCONTEXT_SERVER_DASHBOARD_ENABLED=true
POWERCONTEXT_SERVER_ACCESS_MODE=disabled
# If ACCESS_MODE=enforced, set a long random value locally and never commit it:
# POWERCONTEXT_SERVER_AUTH_TOKEN=replace-with-your-own-token

# --- GapCoach app ---
POWERCONTEXT_CLIENT_SERVER_URL=http://127.0.0.1:18080
GAPCOACH_HOST=127.0.0.1
GAPCOACH_PORT=8000
GAPCOACH_DATA_DIR=__PROJECT_ROOT__/data
# GAPCOACH_SEEKDB_DIR=__PROJECT_ROOT__/data/seekdb
# GAPCOACH_SEEKDB_DB=gapcoach
